{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "readiness", "event"],
  "properties": {
    "status": {"enum": ["completed", "blocked", "needs_human", "failed"]},
    "readiness": {"enum": ["READY", "NOT_READY", "NOT_APPLICABLE"]},
    "event": {"type": "string", "minLength": 1},
    "details": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
